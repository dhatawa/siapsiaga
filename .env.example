DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=siap_siaga
DB_PORT=3306

GROQ_API_KEY=
GNEWS_API_KEY=
WEATHER_API_KEY=
GEMINI_API_KEY=
EMAIL_USER=siapsiagaofc@gmail.com
EMAIL_PASS=

# ===== Frontend (Vite) — hanya variabel berawalan VITE_ yang dikirim ke browser =====
VITE_API_URL=http://localhost:5000/api
VITE_CHATBOT_URL=http://localhost:3000
# API key basemap CARTO (https://carto.com/basemaps/apikey)
VITE_MAP_API_KEY=

# ===== Chatbot (Next.js) =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-opus-5
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:5173

# ===== Email & Notifikasi Berita =====
# EMAIL_PASS harus berupa Google App Password (bukan password akun Gmail); spasi akan diabaikan.
EMAIL_FROM_NAME=Siap Siaga
FRONTEND_URL=http://localhost:5173
# Interval cek berita baru (menit). 0 = matikan notifikasi email berita.
NEWS_EMAIL_INTERVAL_MINUTES=30

# ===== MQTT (perangkat IoT, dibaca oleh Backend/config/mqtt.js) =====
MQTT_ENABLED=false
# mqtt://host:1883 | mqtts://host:8883 | wss://host:8884/mqtt
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=siapsiaga-backend
# Topik: <MQTT_BASE_TOPIC>/devices/<deviceId>/{telemetry|status|alert|cmd}
MQTT_BASE_TOPIC=siapsiaga
MQTT_QOS=1
MQTT_KEEPALIVE=60
MQTT_RECONNECT_MS=5000
MQTT_CONNECT_TIMEOUT_MS=10000
MQTT_TLS_REJECT_UNAUTHORIZED=true
